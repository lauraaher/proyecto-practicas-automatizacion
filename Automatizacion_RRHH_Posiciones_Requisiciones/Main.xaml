      <ui:InvokeCode ContinueOnError="{x:Null}" Code="dtResultados = New System.Data.DataTable()&#xA;&#xA;dtResultados.Columns.Add(&quot;Solicitud_ID&quot;, GetType(String))&#xA;dtResultados.Columns.Add(&quot;Estado&quot;, GetType(String))&#xA;dtResultados.Columns.Add(&quot;Motivo&quot;, GetType(String))&#xA;dtResultados.Columns.Add(&quot;Tipo_Vacante_Solicitud&quot;, GetType(String))&#xA;dtResultados.Columns.Add(&quot;Tipo_Vacante_VP&quot;, GetType(String))&#xA;dtResultados.Columns.Add(&quot;Centro_Costo_Solicitud&quot;, GetType(String))&#xA;dtResultados.Columns.Add(&quot;Centro_Costo_VP&quot;, GetType(String))&#xA;dtResultados.Columns.Add(&quot;Salario&quot;, GetType(String))&#xA;&#xA;Dim lineas As New System.Collections.Generic.List(Of String)&#xA;&#xA;For Each fila As System.Data.DataRow In dtSolicitudes.Rows&#xA;&#xA;    Dim solicitudId As String = fila(&quot;Solicitud_ID&quot;).ToString.Trim&#xA;    Dim ubicacion As String = fila(&quot;Ubicacion&quot;).ToString.Trim&#xA;    Dim centroCosto As String = fila(&quot;Centro_Costo&quot;).ToString.Trim&#xA;    Dim tipoVacante As String = fila(&quot;Tipo_Vacante&quot;).ToString.Trim&#xA;    Dim salarioTexto As String = fila(&quot;Salario_Referencia&quot;).ToString.Trim&#xA;&#xA;    Dim estado As String = &quot;VALIDO PARA REGISTRO SIMULADO&quot;&#xA;    Dim motivo As String = &quot;&quot;&#xA;&#xA;    Dim tipoVacanteVP As String = &quot;&quot;&#xA;    Dim centroCostoVP As String = &quot;&quot;&#xA;&#xA;    ' 1. Validar campos obligatorios simulados&#xA;    If String.IsNullOrWhiteSpace(ubicacion) OrElse&#xA;       String.IsNullOrWhiteSpace(centroCosto) Then&#xA;&#xA;        estado = &quot;REQUIERE REVISION&quot;&#xA;        motivo = &quot;Campo obligatorio faltante&quot;&#xA;&#xA;    Else&#xA;&#xA;        ' 2. Buscar registro correspondiente en Vacantes VP&#xA;        Dim filaVP As System.Data.DataRow = Nothing&#xA;&#xA;        For Each vp As System.Data.DataRow In dtVacantesVP.Rows&#xA;            If vp(&quot;Solicitud_ID&quot;).ToString.Trim = solicitudId Then&#xA;                filaVP = vp&#xA;                Exit For&#xA;            End If&#xA;        Next&#xA;&#xA;        If filaVP Is Nothing Then&#xA;&#xA;            estado = &quot;REQUIERE REVISION&quot;&#xA;            motivo = &quot;Solicitud no encontrada en Vacantes VP&quot;&#xA;&#xA;        Else&#xA;&#xA;            tipoVacanteVP = filaVP(&quot;Tipo_Vacante_Control&quot;).ToString.Trim&#xA;            centroCostoVP = filaVP(&quot;Centro_Costo_Control&quot;).ToString.Trim&#xA;&#xA;            ' 3. Comparar tipo de vacante&#xA;            If tipoVacante &lt;&gt; tipoVacanteVP Then&#xA;&#xA;                estado = &quot;REQUIERE REVISION&quot;&#xA;                motivo = &quot;Tipo de vacante inconsistente entre fuentes&quot;&#xA;&#xA;            ' 4. Comparar centro de costo&#xA;            ElseIf centroCosto &lt;&gt; centroCostoVP Then&#xA;&#xA;                estado = &quot;REQUIERE REVISION&quot;&#xA;                motivo = &quot;Centro de costo inconsistente entre fuentes&quot;&#xA;&#xA;            Else&#xA;&#xA;                ' 5. Validar formato del salario&#xA;                Dim salarioNumerico As Decimal&#xA;&#xA;                If Not Decimal.TryParse(salarioTexto, salarioNumerico) Then&#xA;&#xA;                    estado = &quot;REQUIERE REVISION&quot;&#xA;                    motivo = &quot;Formato de salario no valido&quot;&#xA;&#xA;                End If&#xA;&#xA;            End If&#xA;&#xA;        End If&#xA;&#xA;    End If&#xA;&#xA;    dtResultados.Rows.Add(&#xA;        solicitudId,&#xA;        estado,&#xA;        motivo,&#xA;        tipoVacante,&#xA;        tipoVacanteVP,&#xA;        centroCosto,&#xA;        centroCostoVP,&#xA;        salarioTexto&#xA;    )&#xA;&#xA;    If estado = &quot;REQUIERE REVISION&quot; Then&#xA;&#xA;        lineas.Add(&#xA;            estado &amp;&#xA;            &quot; | &quot; &amp;&#xA;            solicitudId &amp;&#xA;            &quot; | &quot; &amp;&#xA;            motivo&#xA;        )&#xA;&#xA;    Else&#xA;&#xA;        lineas.Add(&#xA;            estado &amp;&#xA;            &quot; | &quot; &amp;&#xA;            solicitudId&#xA;        )&#xA;&#xA;    End If&#xA;&#xA;Next&#xA;&#xA;resumenValidacion =&#xA;    String.Join(&#xA;        System.Environment.NewLine,&#xA;        lineas.ToArray()&#xA;    )&#xA;&#x9;" DisplayName="Invocar código" sap:VirtualizedContainerService.HintSize="686,403" sap2010:WorkflowViewState.IdRef="InvokeCode_1">
